# .flashweb — Single Page Application (React / Vue / Angular / Svelte)
#
# Place in your web root directory.
# All routes are handled by the JS app — only index.html is the real entry point.
# Actual asset files (JS, CSS, images) are served directly from disk.

# ─── Rewrite all unknown paths to index.html ──────────────────────────────────
# FlashLin serves real files directly; only paths with no matching file
# are rewritten to index.html so the JS router can handle them.

[[rewrite]]
from = "/*"
to   = "/index.html"
last = true

# ─── CORS for API calls made from the SPA (adjust origin) ───────────────────

# [cors]
# origin      = "https://yourdomain.com"
# methods     = ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
# headers     = ["Content-Type", "Authorization"]
# credentials = true

# ─── Security headers ─────────────────────────────────────────────────────────

[[header]]
name  = "X-Content-Type-Options"
value = "nosniff"

[[header]]
name  = "X-Frame-Options"
value = "DENY"

[[header]]
name  = "Permissions-Policy"
value = "geolocation=(), microphone=(), camera=()"

# ─── Cache: HTML must not be cached (assets use long TTL via assets.flashweb) --

[cache]
no_cache        = true
must_revalidate = true
