# .flashweb — FlashLin per-directory configuration
#
# Place this file in any directory inside your web root to control
# behaviour for that path and everything below it.
# Rename this file to `.flashweb` to activate it.
#
# Rules from parent directories apply first; the innermost directory wins.

# ─── Redirects ───────────────────────────────────────────────────────────────
# Redirect /old-page permanently to /new-page
[[redirect]]
from = "/old-page"
to   = "/new-page"
code = 301          # 301 permanent, 302 temporary (default)

# Redirect everything under /legacy/ to /docs/
[[redirect]]
from = "/legacy/*"
to   = "/docs/"
code = 301

# ─── Rewrites ────────────────────────────────────────────────────────────────
# Internally rewrite /blog/my-post to /index.php?slug=my-post
# (no redirect shown in the browser)
# [[rewrite]]
# from = "/blog/*"
# to   = "/index.php"
# last = true

# ─── Custom response headers ─────────────────────────────────────────────────
[[header]]
name  = "X-Powered-By"
value = "FlashLin"

# Remove a header (omit value):
# [[header]]
# name = "X-Powered-By"

# Append instead of replace:
# [[header]]
# name   = "Link"
# value  = "</style.css>; rel=preload; as=style"
# append = true

# ─── Cache control ───────────────────────────────────────────────────────────
# Override Cache-Control for this directory
# [cache]
# max_age         = 86400   # seconds (public, max-age=86400)
# no_cache        = false
# no_store        = false
# must_revalidate = false

# ─── CORS ────────────────────────────────────────────────────────────────────
# [cors]
# origin      = "*"
# methods     = ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
# headers     = ["Content-Type", "Authorization"]
# credentials = false
# max_age     = 86400

# ─── IP access control (overrides global) ───────────────────────────────────
# [access]
# allow = ["192.168.0.0/16", "10.0.0.1"]
# deny  = ["203.0.113.0/24"]

# ─── Custom error pages ──────────────────────────────────────────────────────
# [[error_page]]
# code = 404
# file = "/errors/404.html"
#
# [[error_page]]
# code = 500
# file = "/errors/500.html"
